<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardBackgroundColor="#FAF4FB"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 股票代號 -->
        <TextView
            android:id="@+id/tvCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#666666"
            android:textSize="12sp"
            tools:text="2330" />

        <!-- 股票名稱 -->
        <TextView
            android:id="@+id/tvName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#333333"
            android:textSize="22sp"
            android:textStyle="bold"
            tools:text="台積電" />

        <!-- 價格與價差數據網格區 -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="4"
            android:rowCount="3">

            <!-- 第一列：開盤價 / 收盤價 -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:gravity="end"
                android:text="開盤價"
                android:textColor="#666666"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvOpenPrice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1.2"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="#2E7D32"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="1,000.00" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:gravity="end"
                android:text="收盤價"
                android:textColor="#666666"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvClosingPrice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1.2"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="#2E7D32"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="1,020.00" />

            <!-- 第二列：最高價 / 最低價 -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_columnWeight="1"
                android:gravity="end"
                android:text="最高價"
                android:textColor="#666666"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvHighestPrice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_columnWeight="1.2"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="#333333"
                android:textSize="15sp"
                tools:text="1,025.00" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_columnWeight="1"
                android:gravity="end"
                android:text="最低價"
                android:textColor="#666666"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvLowestPrice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_columnWeight="1.2"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="#333333"
                android:textSize="15sp"
                tools:text="995.00" />

            <!-- 第三列：漲跌價差 / 月平均價 -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_columnWeight="1"
                android:gravity="end"
                android:text="漲跌價差"
                android:textColor="#666666"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvChange"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_columnWeight="1.2"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="#2E7D32"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="+20.00" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_columnWeight="1"
                android:gravity="end"
                android:text="月平均價"
                android:textColor="#666666"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvMonthlyAverage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_columnWeight="1.2"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="#333333"
                android:textSize="15sp"
                tools:text="985.50" />
        </GridLayout>

        <!-- 分割線 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="12dp"
            android:background="#E0E0E0" />

        <!-- 底部統計區 (平均分成 3 區塊，垂直堆疊標籤與數值，寬度極限時自動省略) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- 成交筆數 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="成交筆數"
                    android:textColor="#888888"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvTransactionCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="#333333"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="85,420" />
            </LinearLayout>

            <!-- 成交股數 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="成交股數"
                    android:textColor="#888888"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvTradeVolume"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="#333333"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="42,150,200" />
            </LinearLayout>

            <!-- 成交金額 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="成交金額"
                    android:textColor="#888888"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvTradeValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="#333333"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="43,215,800,000" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>